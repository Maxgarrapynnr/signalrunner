# SignalRunner configuration. Copy to .env and fill in.
# The container will NOT work correctly without SECRET_KEY and ENCRYPTION_KEY.

# ── Required ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP — losing it makes all stored Secrets unrecoverable.
ENCRYPTION_KEY=

# ── Core ────────────────────────────────────────────────────────────────────
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Africa/Casablanca
LOG_LEVEL=INFO

# ── Workers ─────────────────────────────────────────────────────────────────
Q_WORKERS=2
WEB_WORKERS=3

# ── Market data ─────────────────────────────────────────────────────────────
MARKETDATA_PROVIDER=casabourse
MARKETDATA_CACHE_TTL_SECONDS=300   # 5 min cache; strategies in same window share one pull
SNAPSHOT_RETENTION_DAYS=30

# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token and chat ID are stored as encrypted Secrets via /admin/,
# not here. After first login, go to /admin/signalrunner/secret/ and add:
#   TELEGRAM_BOT_TOKEN  — from @BotFather
#   TELEGRAM_CHAT_ID    — your personal chat ID (use @userinfobot to find it)
